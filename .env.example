# Local development — copy to .env as needed. Never commit real secrets.

# Database — local SQLite (dev) OR Supabase Postgres
# DATABASE_URL=sqlite+aiosqlite:///./local_app.db
#
# Supabase: Dashboard → Project Settings → Database → Connection string → URI
# Change scheme to postgresql+asyncpg:// and keep ?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?ssl=require

# Supabase Storage (public bucket: uploads)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Server
ENVIRONMENT=dev
DEBUG=true
PORT=8000
HOST=0.0.0.0
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Frontend (local)
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Production (Railway) — set on each service; do NOT hardcode in code
# Public portal / admin: your frontend Railway URL(s) (*.up.railway.app)
# Planned custom domains (when DNS is ready):
#   Public portal:  https://mfec.masaralfahad.com
#   Admin panel:    https://mfec-admin.masaralfahad.com
# ---------------------------------------------------------------------------
# Backend service variables (required for production login):
# FRONTEND_URL=https://YOUR-FRONTEND.up.railway.app
# CORS_ORIGINS=https://YOUR-FRONTEND.up.railway.app
#   (comma-separate portal + admin if they are different origins)
# PYTHON_BACKEND_URL=https://YOUR-BACKEND.up.railway.app
# SUPER_ADMIN_USERNAME=admin
# SUPER_ADMIN_PASSWORD=<set a strong password — empty skips admin seed>
# JWT_SECRET_KEY=<long random secret>
# DATABASE_URL=<postgres URL>
#
# Frontend service variables (build-time — then redeploy frontend):
# VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app
# (alias) VITE_API_URL=https://YOUR-BACKEND.up.railway.app
#
# Custom domains later:
# FRONTEND_URL=https://mfec.masaralfahad.com
# CORS_ORIGINS=https://mfec.masaralfahad.com,https://mfec-admin.masaralfahad.com
# VITE_API_BASE_URL=https://api.masaralfahad.com

# Super Admin seed (local defaults — change in production)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin@12345

MGX_IGNORE_INIT_ADMIN=true

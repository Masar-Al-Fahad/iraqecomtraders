# Frontend env (local). For production set these in the build/host environment.

VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional target for Vite's development-only /api proxy:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Production (Vite build-time vars — set on Railway / Vercel / Netlify)
# ---------------------------------------------------------------------------
# Required on the FRONTEND service (must be present at *Docker build* time).
# Use your Railway FastAPI public URL, no trailing slash.
# Preferred name:
# VITE_API_BASE_URL=https://iraqecomtraders-production.up.railway.app
# Alias also accepted by config.ts / Dockerfile:
# VITE_API_URL=https://iraqecomtraders-production.up.railway.app
#
# After changing VITE_API_* you MUST redeploy/rebuild the frontend
# (Vite embeds the value at build time; runtime env alone is not enough).
#
# Optional planned custom domains (DNS not configured yet as of Aug 2026):
# VITE_API_BASE_URL=https://api.masaralfahad.com
# VITE_SITE_URL=https://mfec.masaralfahad.com
# VITE_ADMIN_URL=https://mfec-admin.masaralfahad.com
#
# After frontend is live, also update BACKEND Railway vars:
#   FRONTEND_URL=<frontend public origin, e.g. https://xxx.up.railway.app>
#   CORS_ORIGINS=<same origin, comma-separated if portal+admin differ>
#   SUPER_ADMIN_USERNAME=admin
#   SUPER_ADMIN_PASSWORD=<strong password>
